{
  "name": "codesafe-mcp",
  "version": "0.1.0",
  "description": "MCP server for real-time security analysis in AI-assisted development",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xneobyte/codesafe-mcp.git"
  },
  "bin": {
    "codesafe-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js && mkdir -p build/data && cp src/data/* build/data/",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "files": ["build"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@google/genai": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
